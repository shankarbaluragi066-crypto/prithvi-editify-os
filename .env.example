# SUPABASE CLIENT CONFIGURATION (Safe for browser/client bundles with Row Level Security)
# Set these in your local .env file or in GitHub Repository Settings -> Secrets and variables -> Actions
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"

# OPTIONAL LEGACY ALIAS (Supported automatically by src/lib/supabaseClient.ts)
# VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"

# NEVER expose Supabase service_role or database passwords in VITE_ variables.
