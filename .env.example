# SUPABASE CLIENT CONFIGURATION (Safe for browser/client bundles with Row Level Security)
# Set these in your local .env file or in GitHub / Netlify Environment Variables
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"

# OPTIONAL LEGACY ALIAS (Supported automatically by src/lib/supabaseClient.ts)
# VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"

# SERVER-SIDE AI CREATIVE ASSISTANT CONFIGURATION (Server-Only — NEVER prefix with VITE_)
# Used exclusively by server.ts (/api/admin/ai/*) after verifying administrator authentication.
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL="gemini-3.8-flash"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-lite-image"
STUDIO_ADMIN_EMAIL="shankarbaluragi066@gmail.com"

# NEVER expose Supabase service_role, GEMINI_API_KEY, or database passwords in VITE_ variables.
